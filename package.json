{
	"name": "vscode-amx-netlinx",
	"displayName": "AMX NetLinx",
	"description": "AMX NetLinx language support for VS Code",
	"version": "0.1.0",
	"publisher": "sentry07",
	"icon": "netlinx.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/sentry07/vscode-amx-netlinx.git"
	},
	"license": "GPL-3.0",
	"engines": {
		"vscode": "^1.60.0"
	},
	"categories": [
		"Programming Languages"
	],
	"activationEvents": [
		"onLanguage:netlinx"
	],
	"main": "./src/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "extension.netlinx_transfer",
				"title": "Open AMX File Transfer Utility"
			},
			{
				"command": "extension.netlinx_diag",
				"title": "Open Netlinx Diagnostics"
			},
			{
				"command": "extension.netlinx_help",
				"title": "Open Netlinx Help Reference"
			},
			{
				"command": "extension.netlinx_openincludefolder",
				"title": "Open Global Include Folder in Workspace"
			},
			{
				"command": "extension.netlinx_openlibraryfolder",
				"title": "Open Global Library Folder in Workspace"
			},
			{
				"command": "extension.netlinx_openmodulefolder",
				"title": "Open Global Module Folder in Workspace"
			}
		],
		"configuration": {
			"title": "AMX NetLinx",
			"properties": {
				"amx-netlinx.enableAutoReload": {
					"type": "boolean",
					"default": true,
					"description": "Automatically reload VS Code window when the syntax file changes"
				}
			}
		},
		"languages": [
			{
				"id": "netlinx",
				"aliases": [
					"AMX NetLinx",
					"netlinx"
				],
				"extensions": [
					".axs",
					".axi",
					".axb",
					".lib"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "netlinx",
				"scopeName": "source.netlinx",
				"path": "./syntaxes/amx-netlinx.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "netlinx-source",
				"path": "./snippets/snippets.json"
			},
			{
				"language": "netlinx-library",
				"path": "./snippets/snippets.json"
			}
		],
		"taskDefinitions": [
			{
				"type": "netlinx",
				"properties": {
					"buildPath": {
						"type": "string"
					}
				}
			}
		],
		"problemMatchers": [
			{
				"name": "nlrc",
				"owner": "amx-netlinx",
				"fileLocation": [
					"absolute"
				],
				"pattern": {
					"regexp": "(?:ERROR|WARNING):\\s+(.*?)\\(([0-9]+)\\)([ \\w\\-:&,.\\[\\]]*)[\\v]?",
					"file": 1,
					"location": 2,
					"message": 3
				}
			}
		],
		"configurationDefaults": {
			"[netlinx-source]": {
				"editor.wordBasedSuggestions": true,
				"editor.suggest.snippetsPreventQuickSuggestions": false,
				"editor.quickSuggestions": {
					"other": true,
					"comments": false,
					"strings": false
				},
				"editor.snippetSuggestions": "top"
			},
			"[netlinx-library]": {
				"editor.wordBasedSuggestions": true,
				"editor.suggest.snippetsPreventQuickSuggestions": false,
				"editor.quickSuggestions": {
					"other": true,
					"comments": false,
					"strings": false
				},
				"editor.snippetSuggestions": "top"
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"lint": "eslint src --ext ts",
		"test": "node ./out/test/runTest.js"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.6",
		"@types/node": "^20.11.0",
		"@types/vscode": "^1.74.0",
		"@typescript-eslint/eslint-plugin": "^6.18.1",
		"@typescript-eslint/parser": "^6.18.1",,
		"eslint": "^8.56.0",
		"glob": "^10.3.10",
		"mocha": "^10.2.0",
		"typescript": "^5.3.3",
		"@vscode/vsce": "^2.23.0",
	},
	"__metadata": {
		"id": "sentry07.amx-netlinx",,
		"publisherId": "sentry07",{
		"publisherDisplayName": "Eric Walters"	"command": "extension.netlinx_openmodulefolder",
	}ommands@3",
}	"when": "resourceLangId == netlinx-source"
		"typescript": "^5.3.3",
		"@vscode/vsce": "^2.23.0"
	},
	"__metadata": {
		"id": "sentry07.amx-netlinx",
		"publisherId": "sentry07",
		"publisherDisplayName": "Eric Walters"
	}
}
